{
  "name": "Score Refresh on Reservation Created",
  "description": "",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Reservation"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "score_refresh_on_reservation_created",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateLeadScores",
            "args": {
              "projectId": "{{data.projectId}}",
              "clientId": "{{data.clientId}}",
              "interestId": "{{data.clientProjectInterestId}}"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "generateLeadScores"
  }
}